# Runtime
APP_ENV=development
API_PORT=8080
GIN_MODE=debug
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# Comma-separated proxy CIDRs allowed to set X-Forwarded-For (e.g. 127.0.0.1,10.0.0.0/8).
# Leave empty when the API is directly exposed.
TRUSTED_PROXIES=

# PostgreSQL (required)
DATABASE_URL=postgres://postgres@127.0.0.1:55432/curaclinic?sslmode=disable

# Redis (optional locally)
# Set REDIS_ADDR=memory to use the development in-memory hold store and disable
# permission caching/rate limiting. Production must use a real Redis instance.
REDIS_ADDR=memory
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# Authentication
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-random-characters
JWT_ISSUER=curaclinic-api
JWT_AUDIENCE=curaclinic-web
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
JWT_SESSION_IDLE_TTL=30m
BCRYPT_COST=12

# Clinic / booking rules
CLINIC_TIMEZONE=Africa/Nairobi
BOOKING_LEAD_TIME=30m
BOOKING_HORIZON_DAYS=90
HOLD_TTL=5m
RBAC_CACHE_TTL=60s

# Rate limiting
RATE_LIMIT_GLOBAL_PER_MIN=240
RATE_LIMIT_AUTH_PER_15MIN=20

# Bootstrap admin (used by `go run ./cmd/seed`)
BOOTSTRAP_ADMIN_EMAIL=admin@curaclinic.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe-At-Least-12-Chars
BOOTSTRAP_ADMIN_FIRST_NAME=Clinic
BOOTSTRAP_ADMIN_LAST_NAME=Admin
